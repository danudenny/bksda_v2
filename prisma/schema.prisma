// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// 1. Konfigurasi Generator dan Datasource
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
  binaryTargets   = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

// ============================================
// 2. ENUMS
// ============================================

enum Role {
  ADMIN
  AUTHOR
}

enum GalleryRow {
  ROW_1
  ROW_2
  ROW_3
}

enum LinkStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum MenuType {
  LINK
  PAGE
}

// ============================================
// 3. AUTHENTICATION & USER MANAGEMENT
// ============================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String // Must be hashed with bcrypt
  role      Role     @default(AUTHOR)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  posts         Post[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

// ============================================
// 4. NEWS & BLOG SECTION
// ============================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[]

  @@index([slug])
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String    @db.Text
  excerpt     String?   @db.Text
  imageUrl    String
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId String
  pageViews  PageView[]

  @@index([slug])
  @@index([authorId])
  @@index([categoryId])
  @@index([published])
}

// ============================================
// 5. ANNOUNCEMENT MARQUEE
// ============================================

model AnnouncementCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  announcements Announcement[]

  @@index([slug])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  date      String
  content   String   @db.Text
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category   AnnouncementCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId String

  @@index([order])
  @@index([isActive])
  @@index([categoryId])
}

// ============================================
// 6. FOKUS KONSERVASI (Featured Species)
// ============================================

model FokusKonservasi {
  id          String  @id @default(cuid())
  name        String  @unique
  latinName   String
  slug        String  @unique
  imageUrl    String
  description String? @db.Text

  status     String?
  habitat    String?
  population String?
  weight     String?
  length     String?
  threats    String[]
  efforts    String[]

  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([order])
  @@index([isActive])
}

// ============================================
// 7. KAWASAN KONSERVASI (Conservation Areas)
// ============================================

model KawasanCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String   @db.Text
  imageUrl    String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locations KawasanLocation[]

  @@index([slug])
  @@index([order])
  @@index([isActive])
}

model KawasanLocation {
  id          String   @id @default(cuid())
  name        String
  slug        String
  description String?  @db.Text
  content     String?  @db.Text
  imageUrl    String?
  latitude    Float?
  longitude   Float?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   KawasanCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([slug])
}

// ============================================
// 8. GALLERY IMAGES
// ============================================

model GalleryImage {
  id        String     @id @default(cuid())
  imageUrl  String
  altText   String
  row       GalleryRow
  order     Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([row])
  @@index([order])
  @@index([isActive])
}

// ============================================
// 9. EXTERNAL LINKS (BELIDA)
// ============================================

model ExternalLink {
  id        String     @id @default(cuid())
  title     String
  subtitle  String
  url       String
  status    LinkStatus @default(ACTIVE)
  order     Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([order])
  @@index([status])
  @@index([isActive])
}

// ============================================
// 10. SITE SETTINGS (Global Configuration)
// ============================================

model SiteSettings {
  id String @id @default("global")

  // Contact Info
  footerAddress String @db.Text
  footerPhone   String
  footerEmail   String

  // Social Media
  socialFacebook  String?
  socialTwitter   String?
  socialInstagram String?
  socialYoutube   String?

  // About Section
  aboutDescription String? @db.Text
  aboutImageUrl    String?

  // Hero Section
  heroTitle    String?
  heroSubtitle String?
  heroImageUrl String?

  // CTA Section
  ctaTitle       String?
  ctaDescription String? @db.Text
  ctaButtonText  String?
  ctaButtonUrl   String?

  updatedAt DateTime @updatedAt
}

// ============================================
// 11. IMAGE ASSET MANAGEMENT
// ============================================

model ImageAsset {
  id        String   @id @default(cuid())
  filename  String
  url       String   @unique
  altText   String?
  size      Int // File size in bytes
  mimeType  String
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// ============================================
// 12. AUDIT LOGS
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  action    String // CREATE, UPDATE, DELETE
  entity    String // Model name (Post, Announcement, etc.)
  entityId  String
  changes   String   @db.Text // JSON stringified changes
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model PageView {
  id        String  @id @default(cuid())
  path      String
  ipHash    String?
  userAgent String?
  postId    String?
  post      Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([postId])
  @@index([path])
}

// ============================================
// 13. HERO SECTION SLIDES
// ============================================

model HeroSlide {
  id          String   @id @default(cuid())
  name        String
  type        String
  location    String
  imageUrl    String
  description String   @db.Text
  slug        String? // Optional for now to avoid breaking existing data
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([isActive])
}

// ============================================
// 14. MENU MANAGEMENT
// ============================================

model Menu {
  id        String   @id @default(cuid())
  label     String
  icon      String? // For top-level items (e.g., 'profile', 'regulation')
  href      String?
  type      MenuType @default(LINK)
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Self-relation for hierarchy
  parentId String?
  parent   Menu?   @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Menu[]  @relation("MenuHierarchy")

  // Relation to Page
  pageId String?
  page   Page?   @relation(fields: [pageId], references: [id])

  @@index([parentId])
  @@index([pageId])
  @@index([order])
  @@index([isActive])
}

// ============================================
// 15. PAGE MANAGEMENT (Static Pages)
// ============================================

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String   @db.Text
  blocks    Json?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menus Menu[]

  @@index([slug])
  @@index([published])
}
